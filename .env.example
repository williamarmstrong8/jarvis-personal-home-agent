# ── Vercel AI Gateway ──────────────────────────────────────────────────────────
# Found in: vercel.com/dashboard → AI Gateway → your gateway → API Key
VERCEL_AI_GATEWAY_URL=https://ai-gateway.vercel.sh/v1
VERCEL_AI_GATEWAY_KEY=your_vercel_ai_gateway_key_here

# ── Fish Audio (active text-to-speech) ────────────────────────────────────────
# API key: fish.audio/app/api-keys
# MODEL_ID is your cloned voice id from the Fish Audio dashboard
TTS_PROVIDER=fish
FISH_AUDIO_API_KEY=your_fish_audio_api_key_here
FISH_AUDIO_MODEL_ID=your_fish_voice_model_id_here
FISH_AUDIO_TTS_MODEL=s2.1-pro-free

# ── ElevenLabs (TTS fallback — kept configured) ───────────────────────────────
# API key: elevenlabs.io → Profile → API Key
# Set TTS_PROVIDER=elevenlabs to switch back
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# "Adam" voice — closest to Paul Bettany's Jarvis
ELEVENLABS_VOICE_ID=IKne3meq5aSn9XLyUdCD

# ── Spotify ───────────────────────────────────────────────────────────────────
# Create app at: developer.spotify.com/dashboard
# Required scopes: user-read-playback-state, user-modify-playback-state, streaming
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
# Briefly poll after play/skip until Connect reports the requested new state.
SPOTIFY_DISPLAY_SYNC_TIMEOUT=4.0
SPOTIFY_DISPLAY_SYNC_INTERVAL=0.25
# Auto-open the Mac Spotify app on THIS machine (default on)
SPOTIFY_LAUNCH_LOCAL=1
# Seconds to wait for that app to show up as a Connect device
SPOTIFY_DEVICE_WAIT_SECS=8
# Optional override if auto-detect picks the wrong computer (Spotify device name)
SPOTIFY_DEVICE_NAME=

# ── Gmail OAuth ───────────────────────────────────────────────────────────────
# Enable Gmail API in Google Cloud Console, then download credentials JSON
# Guide: console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0
GMAIL_CREDENTIALS_PATH=./credentials/gmail_credentials.json

# ── Notion ───────────────────────────────────────────────────────────────────
# Create integration: notion.so/my-integrations
# Then share relevant pages with the integration
NOTION_API_KEY=your_notion_integration_key
# Optional: page ID to use as parent for new pages (copy from page URL)
NOTION_DEFAULT_PAGE_ID=
# Optional: Notion database for generated LinkedIn/X drafts
NOTION_CONTENT_DB_ID=

# ── Internal ──────────────────────────────────────────────────────────────────
WS_PORT=8765

# ── Model (voice pipeline, via Vercel AI Gateway) ─────────────────────────────
# Default: google/gemma-4-31b-it (open-weight, Haiku-class)
# Claude:  anthropic/claude-haiku-4.5  |  anthropic/claude-sonnet-4.5
JARVIS_MODEL=google/gemma-4-31b-it

# ── Low-latency voice tuning ─────────────────────────────────────────────────
# With both paths configured, auto prefers whisper.cpp and falls back to the
# existing Python Whisper implementation if the accelerated CLI fails.
STT_BACKEND=auto
WHISPER_CPP_BIN=whisper-cli
WHISPER_CPP_MODEL=
WHISPER_CPP_TIMEOUT=30
# Rolling partials are enabled automatically only for whisper.cpp. Partials
# update/prewarm routing; only the verified final transcript can execute tools.
STT_STREAMING=auto
STT_PARTIAL_INTERVAL_SECS=0.9
STT_PARTIAL_MIN_AUDIO_SECS=0.7
STT_PREVIEW_SILENCE_SECS=0.12
# Final reuse must include all but this much trailing endpoint audio.
STT_FINAL_TAIL_TOLERANCE_SECS=0.09
STT_STREAMING_FINAL_TIMEOUT=30

# Adaptive end-of-speech detection. Tune against recorded commands rather than
# lowering these blindly; overly aggressive values clip final words.
WAKE_THRESHOLD=0.3
# Wake inference stays at 80 ms; recording uses smaller frames so speech
# endpoint timing is more precise.
VAD_FRAME_MS=30
VAD_SILENCE_SECS=0.36
VAD_MIN_RMS=120
VAD_NOISE_MULTIPLIER=2.5
VAD_MAX_RMS=800
MAX_RECORD_SECS=10

# Cached common phrases avoid a TTS request after the first/background render.
AUDIO_OUTPUT_LATENCY=low
TTS_PREROLL_MS=40
TTS_CACHE_ENABLED=1
SPOTIFY_DUCK_SETTLE_SECS=0.20

# ── Raspberry Pi homelab MCP (over Tailscale) ────────────────────────────────
# Copy the Funnel/MagicDNS URL from your Pi. Do not commit the real hostname.
PI_MCP_URL=https://your-pi.tailscale-name.ts.net/mcp
PI_MCP_TOKEN=your_pi_mcp_token_here
PI_MCP_TOOL_TTL=300

# ── Optional integrations ─────────────────────────────────────────────────────
TAVILY_API_KEY=your_tavily_key_here
# Used by content/podcast generation modules that call Anthropic directly.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Jellyfin / homelab web UIs (open in the Mac browser) ──────────────────────
# Hostname can also be set separately as HOMELAB_HOST if Jellyfin isn't used.
JELLYFIN_URL=http://your-pi.tailscale-name.ts.net:8096
JELLYFIN_API_KEY=your_jellyfin_api_key_here
HOMELAB_HOST=your-pi.tailscale-name.ts.net
# Optional override; default is http://<HOMELAB_HOST>:8766
PI_DISPLAY_URL=http://your-pi.tailscale-name.ts.net:8766
